{
  "module": "AgentSteers",
  "name": "AgentSteers Task",
  "doctype": "DocType",
  "custom": 0,
  "istable": 0,
  "autoname": "hash",
  "engine": "InnoDB",
  "track_changes": 1,
  "field_order": [
    "owner_user",
    "repository",
    "instruction",
    "status",
    "created_via",
    "started_at",
    "finished_at",
    "result_summary"
  ],
  "fields": [
    {
      "fieldname": "owner_user",
      "fieldtype": "Link",
      "label": "Owner User",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "repository",
      "fieldtype": "Data",
      "label": "Repository",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "instruction",
      "fieldtype": "Small Text",
      "label": "Instruction",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Queued\nRunning\nCompleted\nFailed\nCancelled",
      "default": "Queued",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "created_via",
      "fieldtype": "Select",
      "label": "Created Via",
      "options": "Dashboard\nMCP\nSystem",
      "default": "Dashboard"
    },
    {
      "fieldname": "started_at",
      "fieldtype": "Datetime",
      "label": "Started At"
    },
    {
      "fieldname": "finished_at",
      "fieldtype": "Datetime",
      "label": "Finished At"
    },
    {
      "fieldname": "result_summary",
      "fieldtype": "Long Text",
      "label": "Sanitized Result Summary",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
