{
  "module": "AgentSteers",
  "name": "AgentSteers Connection",
  "doctype": "DocType",
  "custom": 0,
  "istable": 0,
  "autoname": "hash",
  "track_changes": 1,
  "field_order": [
    "owner_user",
    "label",
    "connection_type",
    "status",
    "last_seen_at",
    "notes"
  ],
  "fields": [
    {
      "fieldname": "owner_user",
      "fieldtype": "Link",
      "label": "Owner User",
      "options": "User",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "label",
      "fieldtype": "Data",
      "label": "Label",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "connection_type",
      "fieldtype": "Select",
      "label": "Type",
      "options": "Codex CLI\nMCP Client\nOther",
      "reqd": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Not Configured\nPending\nConnected\nDisabled",
      "default": "Not Configured",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "last_seen_at",
      "fieldtype": "Datetime",
      "label": "Last Seen At",
      "read_only": 1
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "Notes"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ]
}
