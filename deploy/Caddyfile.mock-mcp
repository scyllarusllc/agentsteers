# MOCK-ONLY MCP endpoint. Requires a separate non-root HTTP service bound
# to 127.0.0.1:8766, server-side Bearer token, DNS, and HTTPS termination.
# Do not use for Codex/production task execution.
mcp.agentsteers.com {
    encode zstd gzip
    header {
        Cache-Control "no-store"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    handle /mcp {
        reverse_proxy 127.0.0.1:8766
    }
    respond 404
}
